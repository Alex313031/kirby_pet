import("../lib/pet_lib.gni")

executable("kirby_pet") {
  configs += [
    ":kirby_pet_config",
  ]
  precompiled_header = "framework.h"
  precompiled_source = "pch.pch"
  sources = [
    "constants.h",
    "desktop.cc",
    "desktop.h",
    "framework.h",
    "globals.h",
    "kirby_pet.rc",
    "main.cc",
    "main.h",
    "pet_window.cc",
    "pet_window.h",
    "resource.h",
    "utils.cc",
    "utils.h",
    "version.h",
  ]

  # Binary resources kirby_pet.rc pulls in. windres' -MMD only reports #included
  # headers, so without these a sprite or icon edit wouldn't rebuild the .res.
  inputs = [
    "../res/bmp/down_1x.bmp",
    "../res/bmp/down_2x.bmp",
    "../res/bmp/left_1x.bmp",
    "../res/bmp/left_2x.bmp",
    "../res/bmp/right_1x.bmp",
    "../res/bmp/right_2x.bmp",
    "../res/bmp/up_1x.bmp",
    "../res/bmp/up_2x.bmp",
    "res/about.ico",
    "res/kirby_pet.manifest",
    "res/main.ico",
    "res/small.ico",
  ]

  deps = [ "../logging:kirbylogger" ]
  # Static lib by default; `use_shared_pet_lib = true` links pet_lib.dll
  # instead (GN links its import library and puts the .dll beside the .exe).
  if (use_shared_pet_lib) {
    deps += [ "../lib:pet_lib_shared" ]
  } else {
    deps += [ "../lib:pet_lib_static" ]
  }

  output_name = "kirby_pet"
  if (is_debug || dcheck_enabled) {
    output_name += "_debug"
  }
}

config("kirby_pet_config") {
  configs = [ "../logging:kirbylogger_config" ]
  # The matching lib config: the shared one adds PET_LIB_SHARED, which turns
  # LIB_API into dllimport (see ../lib/include/lib_export.h).
  if (use_shared_pet_lib) {
    configs += [ "../lib:pet_lib_shared_config" ]
  } else {
    configs += [ "../lib:pet_lib_static_config" ]
  }
  defines = []
  cflags = []
  include_dirs = [ "./", ]
  cflags += [
    "-Wunused-function",
  ]
  libs = [
    "kernel32",
    "user32",
    "shell32",
    "comctl32",
    "comdlg32",
    "gdi32",
    "advapi32",  # registry (persisted speed / color / mode)
  ]
}
